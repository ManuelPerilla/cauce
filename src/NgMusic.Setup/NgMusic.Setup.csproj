<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>NgMusicSetup</AssemblyName>
    <RootNamespace>NgMusic.Setup</RootNamespace>
    <RuntimeIdentifiers>win-x64;win-arm64;win-x86</RuntimeIdentifiers>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup Condition="'$(MsiPath)' != ''">
    <EmbeddedResource Include="$(MsiPath)" LogicalName="NgMusic.Setup.Payload.msi" />
  </ItemGroup>

  <Target Name="ValidateEmbeddedMsi" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(MsiPath)' == ''" Text="MsiPath must point to the architecture-matching NgMusic MSI." />
    <Error Condition="'$(MsiPath)' != '' and !Exists('$(MsiPath)')" Text="The MSI specified by MsiPath does not exist: $(MsiPath)" />
  </Target>
</Project>
