<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Cauce</AssemblyName>
    <RootNamespace>Cauce.Desktop</RootNamespace>
    <Product>Cauce</Product>
    <Company>Cauce</Company>
    <Version>0.6.0-alpha.1</Version>
    <VersionPrefix>0.6.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
    <Description>Tu biblioteca de música, con calma. Reproductor nativo para Windows.</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/cauce.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cauce.Core\Cauce.Core.csproj" />
    <PackageReference Include="Duende.IdentityModel.OidcClient" Version="7.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.23.0" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
</Project>
