<Window x:Class="Cauce.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Cauce.Core;assembly=Cauce.Core"
        Title="Cauce — tu música, a tu ritmo" Width="1060" Height="760"
        MinWidth="850" MinHeight="650" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.Name="Cauce, reproductor de música">
  <Grid>
    <Grid Margin="26,18,26,0">
      <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsCompact}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding OnboardingVisible}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="128" /></Grid.RowDefinitions>
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Top">
          <Border Width="42" Height="42" Background="{DynamicResource AccentBrush}" CornerRadius="14" Margin="0,2,12,0">
            <TextBlock Text="≈" Foreground="{DynamicResource AccentTextBrush}" FontSize="37" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-8,0,0" />
          </Border>
          <StackPanel><TextBlock Text="cauce" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="MÚSICA A TU RITMO" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="Compacto" Command="{Binding ToggleCompactCommand}" Margin="12,5,0,0" VerticalAlignment="Top" AutomationProperties.Name="Cambiar a reproductor compacto" />
        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSoftBrush}" CornerRadius="12" Padding="12,6" VerticalAlignment="Top" Margin="0,11,0,0"><TextBlock Text="Tu biblioteca · En este equipo" FontSize="11" /></Border>
      </DockPanel>

      <TabControl Grid.Row="1" AutomationProperties.Name="Secciones de Cauce">
        <TabItem Header="Escuchar" AutomationProperties.Name="Escuchar música">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
            <StackPanel>
              <TextBlock Text="Un buen momento para escuchar." Style="{StaticResource PageTitle}" />
              <TextBlock Text="Elige un género. Cauce se encarga de lo que sigue." Style="{StaticResource Secondary}" Margin="0,0,0,24" />
              <Border Style="{StaticResource Panel}">
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="TU SESIÓN" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" />
                    <Label Content="¿Qué te apetece escuchar?" Target="{Binding ElementName=GenrePicker}" Padding="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" FontWeight="SemiBold" />
                    <ComboBox x:Name="GenrePicker" ItemsSource="{Binding Genres}" SelectedItem="{Binding SelectedGenre, Mode=TwoWay}" Margin="0,13,24,12" MaxWidth="360" HorizontalAlignment="Stretch" AutomationProperties.Name="Género de la sesión" />
                    <TextBlock Text="{Binding QueueReason}" Style="{StaticResource Secondary}" Margin="0,0,24,8" />
                    <CheckBox IsChecked="{Binding AllowRepeats}" Content="Permitir repetir al terminar el género" AutomationProperties.Name="Permitir repetir canciones" />
                    <Label Content="Separar canciones del mismo artista" Target="{Binding ElementName=ArtistSpacingSlider}" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,9,0,4" />
                    <DockPanel Margin="0,0,24,0"><TextBlock DockPanel.Dock="Right" Text="{Binding ArtistSpacing, StringFormat={}{0} canciones}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="14,0,0,0" VerticalAlignment="Center" /><Slider x:Name="ArtistSpacingSlider" Value="{Binding ArtistSpacing, Mode=TwoWay}" Minimum="0" Maximum="5" TickFrequency="1" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" AutomationProperties.Name="Número de canciones entre repeticiones de artista" /></DockPanel>
                    <TextBlock Text="Usa 0 si hay pocos artistas en tu biblioteca." Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,24,0" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource GlassHighlightBrush}" CornerRadius="65" Width="124" Height="124" VerticalAlignment="Center" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid><Ellipse Stroke="{DynamicResource BorderBrush}" Margin="15" StrokeThickness="1" /><Ellipse Stroke="{DynamicResource BorderBrush}" Margin="28" StrokeThickness="1" /><Ellipse Fill="{DynamicResource AccentBrush}" Width="30" Height="30" /><Ellipse Fill="{DynamicResource SolidSurfaceBrush}" Width="7" Height="7" /></Grid>
                  </Border>
                </Grid>
              </Border>
              <Border Background="{DynamicResource WarmBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18,15" Margin="0,16,0,0" Visibility="{Binding TipsEnabled, Converter={StaticResource BooleanToVisibility}}">
                <StackPanel><TextBlock Text="Empieza por algo tuyo" FontWeight="SemiBold" Margin="0,0,0,4" /><TextBlock Text="Añade archivos desde Biblioteca. Puedes ponerles un género para que la siguiente canción encaje con tu sesión." Style="{StaticResource Secondary}" /></StackPanel>
              </Border>
              <WrapPanel Margin="0,19,0,0">
                <Button Content="Añadir música" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8" AutomationProperties.Name="Añadir archivos de música" />
                <Button Content="Cómo funciona" Command="{Binding ReplayTutorialCommand}" Margin="0,0,0,8" AutomationProperties.Name="Abrir guía inicial" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Biblioteca" AutomationProperties.Name="Biblioteca musical">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
            <StackPanel>
              <DockPanel Margin="0,0,0,15"><Button Content="Añadir archivos" Command="{Binding ImportCommand}" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" VerticalAlignment="Top" /><StackPanel><TextBlock Text="Tu biblioteca" Style="{StaticResource PageTitle}" /><TextBlock Text="Archivos y enlaces que tú eliges." Style="{StaticResource Secondary}" /></StackPanel></DockPanel>
              <Grid Height="220">
                <DataGrid ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack, Mode=TwoWay}" AutomationProperties.Name="Canciones de tu biblioteca">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*" />
                    <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="*" />
                    <DataGridTextColumn Header="Género" Binding="{Binding Genre}" Width="*" />
                    <DataGridTemplateColumn Header="Disponible" Width="1.4*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                            <TextBlock.Style>
                              <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Text" Value="Archivo no disponible" />
                                <Style.Triggers>
                                  <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                      <Condition Binding="{Binding Source}" Value="{x:Static core:TrackSource.LocalFile}" />
                                      <Condition Binding="{Binding IsAvailable}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Text" Value="En este equipo" />
                                  </MultiDataTrigger>
                                  <DataTrigger Binding="{Binding Source}" Value="{x:Static core:TrackSource.ExternalLink}">
                                    <Setter Property="Text" Value="Abrir en su plataforma" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <Border Background="{DynamicResource SolidSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                  <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Tracks.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="390"><TextBlock Text="Tu primera canción va aquí" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8" /><TextBlock Text="Añade música de este equipo para empezar. Tus archivos se quedan donde están." Style="{StaticResource Secondary}" TextAlignment="Center" /><Button Content="Elegir archivos" Command="{Binding ImportCommand}" Margin="0,16,0,0" HorizontalAlignment="Center" /></StackPanel>
                </Border>
              </Grid>
              <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,9,0"><Label Content="Artista" Target="{Binding ElementName=ArtistEditor}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="0,0,0,5" FontSize="12" /><TextBox x:Name="ArtistEditor" Text="{Binding ArtistEditText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Editar artista de la canción seleccionada" /></StackPanel>
                <StackPanel Grid.Column="1"><Label Content="Género" Target="{Binding ElementName=GenreEditor}" Foreground="{DynamicResource TextSecondaryBrush}" Padding="0,0,0,5" FontSize="12" /><TextBox x:Name="GenreEditor" Text="{Binding GenreEditText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Editar género de la canción seleccionada" /></StackPanel>
                <Button Grid.Column="2" Content="Guardar datos" Command="{Binding ApplyGenreCommand}" Margin="9,0,0,0" VerticalAlignment="Bottom" />
                <Button Grid.Column="3" Content="Quitar" Command="{Binding RemoveTrackCommand}" Margin="9,0,0,0" VerticalAlignment="Bottom" ToolTip="Quitar de la biblioteca sin borrar el archivo original" AutomationProperties.Name="Quitar canción seleccionada de la biblioteca" />
              </Grid>
              <Button Content="Reproducir selección" Command="{Binding PlaySelectedCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="Reproducir canción seleccionada" />
              <Expander Header="Guardar un enlace de música" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,20,0,0" Padding="0,6" AutomationProperties.Name="Añadir enlace externo">
                <StackPanel Margin="0,12,0,0">
                  <TextBlock Text="Los enlaces se abren en su servicio original. No se descargan ni se reproducen dentro de Cauce." Style="{StaticResource Secondary}" Margin="0,0,0,12" />
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,9,0"><Label Content="Título" Foreground="{DynamicResource TextSecondaryBrush}" Padding="0,0,0,4" Target="{Binding ElementName=LinkTitleInput}" /><TextBox x:Name="LinkTitleInput" Text="{Binding LinkTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Título del enlace" /></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,9,0"><Label Content="Enlace https://" Foreground="{DynamicResource TextSecondaryBrush}" Padding="0,0,0,4" Target="{Binding ElementName=LinkUrlInput}" /><TextBox x:Name="LinkUrlInput" Text="{Binding LinkUrl, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Dirección del enlace https" /></StackPanel>
                    <Button Grid.Column="2" Content="Guardar" Command="{Binding AddLinkCommand}" VerticalAlignment="Bottom" AutomationProperties.Name="Guardar enlace en biblioteca" />
                  </Grid>
                  <Button Content="Abrir enlace seleccionado" Command="{Binding OpenExternalCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Apariencia" AutomationProperties.Name="Apariencia y accesibilidad">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
            <StackPanel><TextBlock Text="Hazlo tuyo" Style="{StaticResource PageTitle}" /><TextBlock Text="Un espacio cómodo para tus ojos y tu manera de escuchar." Style="{StaticResource Secondary}" Margin="0,0,0,22" />
              <Border Style="{StaticResource Panel}"><StackPanel>
                <Label Content="Tema" Target="{Binding ElementName=ThemePicker}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="17" FontWeight="SemiBold" Padding="0,0,0,10" />
                <ComboBox x:Name="ThemePicker" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" MaxWidth="340" HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="Tema de la aplicación" />
                <TextBlock Text="Sistema sigue el aspecto de Windows. El alto contraste de Windows siempre tiene prioridad." Style="{StaticResource Secondary}" Margin="0,12,0,17" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,13,0,0"><StackPanel>
                  <CheckBox Content="Reducir movimiento" IsChecked="{Binding ReducedMotion}" AutomationProperties.Name="Reducir movimiento" /><TextBlock Text="Desactiva la animación breve de los botones." Style="{StaticResource Secondary}" FontSize="12" Margin="28,0,0,8" />
                  <CheckBox Content="Reducir transparencias" IsChecked="{Binding ReducedTransparency}" AutomationProperties.Name="Reducir transparencias" /><TextBlock Text="Usa superficies sólidas para distinguir mejor los controles." Style="{StaticResource Secondary}" FontSize="12" Margin="28,0,0,8" />
                  <CheckBox Content="Mostrar consejos útiles" IsChecked="{Binding TipsEnabled}" AutomationProperties.Name="Mostrar consejos útiles" />
                </StackPanel></Border>
              </StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Guía" AutomationProperties.Name="Guía y preguntas frecuentes">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
            <StackPanel><TextBlock Text="Encuentra tu ritmo" Style="{StaticResource PageTitle}" /><TextBlock Text="Lo esencial, sin prisa." Style="{StaticResource Secondary}" Margin="0,0,0,22" />
              <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="Tres pasos para empezar" Style="{StaticResource SectionTitle}" /><TextBlock Text="1. Añade tus archivos en Biblioteca.&#x0a;2. Selecciona una canción y guarda su género.&#x0a;3. Elige ese género en Escuchar y pulsa Reproducir." LineHeight="27" /><Button Content="Volver a ver la bienvenida" Command="{Binding ReplayTutorialCommand}" HorizontalAlignment="Left" Margin="0,15,0,0" /></StackPanel></Border>
              <TextBlock Text="Preguntas frecuentes" Style="{StaticResource SectionTitle}" Margin="0,23,0,9" />
              <Expander Header="¿Necesito una cuenta?" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,8"><TextBlock Text="No. Tu biblioteca local y la reproducción funcionan sin cuenta. El acceso a cuentas estará disponible cuando se configure el servicio correspondiente." Style="{StaticResource Secondary}" Margin="24,9,0,10" /></Expander>
              <Expander Header="¿Por qué no suena un enlace?" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,8"><TextBlock Text="Un enlace abre la música en su servicio original. Para reproducir dentro de Cauce, añade archivos de audio guardados en este equipo." Style="{StaticResource Secondary}" Margin="24,9,0,10" /></Expander>
              <Expander Header="¿Qué ocurre cuando termina un género?" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,8"><TextBlock Text="La sesión se detiene si no quedan canciones elegibles. Activa Permitir repetir en Escuchar si quieres volver a recorrer ese género." Style="{StaticResource Secondary}" Margin="24,9,0,10" /></Expander>
              <Expander Header="¿Quitar una canción borra mi archivo?" Foreground="{DynamicResource TextPrimaryBrush}" Padding="0,8"><TextBlock Text="No. Quitar elimina la entrada de la biblioteca de Cauce. El archivo original permanece en su carpeta." Style="{StaticResource Secondary}" Margin="24,9,0,10" /></Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Cuenta" AutomationProperties.Name="Cuenta y datos">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
            <StackPanel><TextBlock Text="Tú eliges cómo entrar" Style="{StaticResource PageTitle}" /><TextBlock Text="Tu música local está disponible desde el primer momento." Style="{StaticResource Secondary}" Margin="0,0,0,22" />
              <Border Style="{StaticResource Panel}"><StackPanel>
                <TextBlock Text="{Binding AccountStatus}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,9" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="Las cuentas se habilitan cuando se configure el servicio de acceso. Tu biblioteca funciona sin cuenta." Style="{StaticResource Secondary}" Margin="0,0,0,16" />
                <UniformGrid Columns="2" Rows="2" IsEnabled="{Binding CanSignIn}">
                  <Button Content="Continuar con Google" Command="{Binding SignInCommand}" CommandParameter="google" Margin="0,0,8,8" />
                  <Button Content="Continuar con Apple" Command="{Binding SignInCommand}" CommandParameter="apple" Margin="0,0,0,8" />
                  <Button Content="Continuar con Facebook" Command="{Binding SignInCommand}" CommandParameter="facebook" Margin="0,0,8,0" />
                  <Button Content="Continuar con Microsoft" Command="{Binding SignInCommand}" CommandParameter="microsoft" />
                </UniformGrid>
                <Button Content="Cerrar sesión" Command="{Binding SignOutCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
              </StackPanel></Border>
              <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Tus datos, a mano" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding StorageSummary}" Style="{StaticResource Secondary}" /><WrapPanel Margin="0,14,0,0"><Button Content="Exportar mis datos" Command="{Binding ExportDataCommand}" Margin="0,0,10,8" /><Button Content="Restablecer datos locales" Command="{Binding ClearDataCommand}" Margin="0,0,0,8" ToolTip="Cauce pedirá confirmación antes de restablecer tus datos" /></WrapPanel></StackPanel></Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Soporte" AutomationProperties.Name="Soporte y contacto">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
            <StackPanel><TextBlock Text="Sigamos mejorando Cauce" Style="{StaticResource PageTitle}" /><TextBlock Text="Si algo interrumpe tu música, cuéntanos qué pasó." Style="{StaticResource Secondary}" Margin="0,0,0,22" />
              <Border Style="{StaticResource Panel}"><StackPanel><TextBlock Text="¿Encontraste un problema?" Style="{StaticResource SectionTitle}" /><TextBlock Text="Describe qué intentabas hacer y qué ocurrió. Puedes revisar el reporte antes de enviarlo; no se envía información automáticamente." Style="{StaticResource Secondary}" /><Button Content="Preparar reporte de un problema" Command="{Binding OpenBugReportCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" Style="{StaticResource PrimaryButton}" /></StackPanel></Border>
              <Border Style="{StaticResource Panel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Una idea o una pregunta" Style="{StaticResource SectionTitle}" /><TextBlock Text="Las pequeñas mejoras también cuentan. Abre el espacio de soporte para compartir sugerencias o pedir ayuda." Style="{StaticResource Secondary}" /><Button Content="Abrir soporte" Command="{Binding OpenSupportCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" /></StackPanel></Border>
              <TextBlock Text="Cauce · 0.6.0 alpha 1" Style="{StaticResource Secondary}" FontSize="11" Margin="2,20,0,0" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>

      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="19,19,0,0" Padding="20,13,20,10" Margin="0,14,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,14,0"><TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /><TextBlock Text="{Binding CurrentArtist}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0" /></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding PlaybackLabel}" Command="{Binding PlayPauseCommand}" Style="{StaticResource PrimaryButton}" MinWidth="112" AutomationProperties.Name="Reproducir o pausar" /><Button Content="Siguiente ›" Command="{Binding NextCommand}" Margin="8,0,0,0" AutomationProperties.Name="Siguiente canción" /></StackPanel>
            <Grid Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Vol." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" /><Slider Grid.Column="1" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.1" VerticalAlignment="Center" AutomationProperties.Name="Volumen de reproducción" /></Grid>
          </Grid>
          <Grid Grid.Row="1" Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ProgressBar Value="{Binding PlaybackProgress}" Minimum="0" Maximum="1" Height="3" Background="{DynamicResource SubtleSurfaceBrush}" Foreground="{DynamicResource AccentBrush}" BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="Progreso de la canción" /><TextBlock Grid.Column="1" Text="{Binding PlaybackTime}" Margin="10,0,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid>
          <TextBlock Grid.Row="2" Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.LiveSetting="Polite" />
        </Grid>
      </Border>
    </Grid>

    <Grid Margin="18,12" Visibility="{Binding IsCompact, Converter={StaticResource BooleanToVisibility}}">
      <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding OnboardingVisible}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Grid.Style>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <DockPanel><Button Content="Ampliar" Command="{Binding ToggleCompactCommand}" DockPanel.Dock="Right" MinHeight="28" Padding="10,4" FontSize="11" AutomationProperties.Name="Volver a ventana completa" /><TextBlock Text="≈  cauce" FontWeight="SemiBold" FontSize="18" /></DockPanel>
      <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,9"><TextBlock Text="{Binding CurrentTitle}" FontWeight="SemiBold" FontSize="16" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding CurrentArtist}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="{Binding PlaybackLabel}" Command="{Binding PlayPauseCommand}" Style="{StaticResource PrimaryButton}" MinWidth="112" Padding="12,8" /><Button Grid.Column="1" Content="Siguiente" Command="{Binding NextCommand}" Margin="8,0,0,0" Padding="10,8" /><Slider Grid.Column="2" Value="{Binding Volume, Mode=TwoWay}" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" Margin="13,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Volumen" /></Grid>
      <TextBlock Grid.Row="3" Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <Border Background="{DynamicResource OverlayBrush}" Visibility="{Binding OnboardingVisible, Converter={StaticResource BooleanToVisibility}}" KeyboardNavigation.TabNavigation="Cycle" IsVisibleChanged="OnboardingVisibilityChanged">
      <Border Style="{StaticResource Panel}" Background="{DynamicResource SolidSurfaceBrush}" Width="490" MaxHeight="540" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" AutomationProperties.Name="Bienvenida a Cauce">
        <StackPanel><TextBlock Text="BIENVENIDO A CAUCE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,18" /><TextBlock Text="{Binding TutorialTitle}" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,13" /><TextBlock Text="{Binding TutorialBody}" Style="{StaticResource Secondary}" FontSize="15" LineHeight="24" Margin="0,0,0,24" /><TextBlock Text="{Binding TutorialProgress}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,12" /><WrapPanel><Button Content="Anterior" Command="{Binding PreviousTutorialCommand}" Margin="0,0,9,9" /><Button x:Name="TutorialNextButton" Content="Siguiente" Command="{Binding NextTutorialCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,9,9" /><Button Content="Empezar a escuchar" Command="{Binding FinishTutorialCommand}" Margin="0,0,0,9" /></WrapPanel></StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>

