<Project>
  <PropertyGroup>
    <VersionPrefix>0.6.0</VersionPrefix>
    <VersionSuffix>rc.1</VersionSuffix>
    <Company>Cauce</Company>
    <Authors>Cauce contributors</Authors>
    <Product>Cauce</Product>
    <Description>Native Windows music player with a reference library and transparent genre sessions.</Description>
    <RepositoryUrl>https://github.com/ManuelPerilla/cauce</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
