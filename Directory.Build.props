<Project>
  <PropertyGroup>
    <VersionPrefix>0.5.4</VersionPrefix>
    <Company>NgMusic</Company>
    <Authors>NgMusic contributors</Authors>
    <Product>NgMusic</Product>
    <Description>PowerShell-style personal YouTube music controller for Windows.</Description>
    <RepositoryUrl>https://github.com/ManuelPerilla/ngmusic</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
