<Project>
  <PropertyGroup>
    <VersionPrefix>0.5.4</VersionPrefix>
    <Company>Cauce.Terminal</Company>
    <Authors>Cauce.Terminal contributors</Authors>
    <Product>Cauce.Terminal</Product>
    <Description>PowerShell-style personal YouTube music controller for Windows.</Description>
    <RepositoryUrl>https://github.com/ManuelPerilla/cauce</RepositoryUrl>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
