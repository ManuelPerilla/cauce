<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Id="NgMusic.Windows"
      Name="NgMusic"
      Manufacturer="NgMusic"
      Version="$(Version)"
      Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of NgMusic is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="NGMUSIC_WRAPPER" Secure="yes" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="NgMusic">
        <Files Include="$(PayloadDir)\**" />
        <Component Id="ConfiguratorComponent" Guid="*">
          <File Id="ConfiguratorExe" Source="$(ConfiguratorPath)" Name="NgMusicConfigurator.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Component Id="PathRegistration" Directory="INSTALLFOLDER" Guid="*">
      <Environment Id="NgMusicPath" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="yes" Permanent="no" />
      <RegistryValue Root="HKLM" Key="Software\NgMusic" Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>

    <CustomAction
        Id="LaunchConfigurator"
        FileRef="ConfiguratorExe"
        ExeCommand=""
        Execute="immediate"
        Return="asyncNoWait"
        Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom
          Action="LaunchConfigurator"
          After="InstallFinalize"
          Condition="NOT Installed AND UILevel &gt;= 4 AND NOT NGMUSIC_WRAPPER" />
    </InstallExecuteSequence>
  </Package>
</Wix>
